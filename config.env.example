# Configurazione di AURA.
# Copiare questo file in config.env e modificarlo: config.env è escluso da git
# e dall'immagine Docker, quindi è l'unico posto per i valori reali.
# Senza config.env valgono i valori predefiniti indicati qui sotto.

# Fonte dei dati dell'impianto:
#   fake = impianto simulato in memoria (predefinito)
#   knx  = KNX IoT 3rd Party API (adattatore da implementare)
AURA_BACKEND=fake

# Livello dei log: DEBUG, INFO, WARNING o ERROR.
AURA_LOG_LEVEL=INFO

# Indirizzo e porta del server MCP, solo per l'avvio senza Docker
# (con docker compose valgono 0.0.0.0 e 8000).
# AURA_HOST=127.0.0.1
# AURA_PORT=8000

# Le variabili per l'accesso alle KNX IoT 3rd Party API (OAuth2) si aggiungono qui
# insieme all'adattatore reale. I valori veri vanno solo in config.env.
